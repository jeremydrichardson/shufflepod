{
  "name": "shufflepod",
  "version": "1.0.0",
  "description": "A service for creating shuffled podcast feeds",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "build": "tsc",
    "deploy": "netlify deploy --prod",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "podcast",
    "rss",
    "shuffle",
    "feed"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.3",
    "@netlify/functions": "^2.8.1",
    "rss-parser": "^3.13.0",
    "feed": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "typescript": "^5.6.2",
    "netlify-cli": "^17.36.2",
    "@types/jest": "^29.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@jest/globals": "^29.7.0"
  }
}
